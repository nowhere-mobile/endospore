        android:fillType="evenOdd"
        android:pathData="M2,4 H22 V20 H2 Z M4,6 V18 H20 V6 Z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M4,6 L12,11 L20,6 L20,8.4 L12,13.4 L4,8.4 Z" />
