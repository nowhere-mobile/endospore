<?xml version="1.0" encoding="utf-8"?>
<!--
  Endospore boot-brand overlay (task #160). Between the endospore boot ANIMATION ending (~5s, torn down
  when WindowManager sees the first home window) and the kiosk gate drawing (~8s, at BOOT_COMPLETED),
  AOSP's com.android.settings/.FallbackHome is the transient boot HOME. Stock, it is a transparent window
  showing the system wallpaper with a "Starting Android" spinner faded in after a timeout: unbranded churn.

  This redefines @style/FallbackHome (a static PRODUCT_PACKAGE_OVERLAYS replacement, merged into the
  source-built Settings.apk at build time, same mechanism as the shipping Launcher3 overlay) so the window
  paints the endospore steady-state frame instead: an OPAQUE brand windowBackground with the wallpaper OFF.
  Paired with the fallback_home_finishing_boot.xml override (spinner stripped) so the whole FallbackHome
  window reads as one continuous endospore screen, seamless with the boot animation's final frame.
-->
<resources>
    <style name="FallbackHome" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/endospore_boot_brand</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
    </style>
</resources>
