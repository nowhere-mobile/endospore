# Endospore system-side components (E.2) -- the GrapheneOS/Pixel edition's product fragment.
#
# Injected into the GrapheneOS `lynx` product via build/inject-product.sh, which appends
#   $(call inherit-product-if-exists, vendor/endospore/endospore.mk)
# to the adevtool-generated vendor/google_devices/lynx/lynx.mk AFTER `adevtool generate-all`
# (that file is "Generated by adevtool; do not edit", so the inherit is re-applied by the build
# script rather than committed into the generated tree). Keeping the product name `lynx` means the
# E.1 release/signing tooling (generate-release.sh lynx <build>) keeps working unchanged.
#
# This reuses core/ unchanged (assembled into vendor/endospore by build/stage-vendor.sh): the agent,
# the chooser, the init .rc, the su:s0 workers, default-permissions. It supplies ONLY the edition
# delta -- which packages to install and the GrapheneOS-specific bits. The LineageOS-only pieces from
# editions/diaspore/diaspore.mk are intentionally DROPPED here: the LineageParts/SetupWizard/Trebuchet
# RRO overlay, the lineage_bootanimation hook, and the tier-3 geotz provider all assume the LineageOS
# base and have no analogue in GrapheneOS.

# ---------------------------------------------------------------------------------------------------
# Core roaming components (shared, from core/vendor-common -> vendor/endospore via stage-vendor).
# Module names are defined in vendor/endospore/Android.bp (= core/vendor-common/Android.bp).
PRODUCT_PACKAGES += \
    nowhere_agent \
    nowhere_seed_home \
    nowhere_db_fix \
    nowhere_login.sh \
    nowhere_provision.sh \
    nowhere_roamd.sh \
    nowhere_otad.sh \
    update_engine_client \
    nowhere_mediad.sh \
    nowhere_gate.sh \
    nowhere.rc \
    NowhereChooser \
    NowhereApps \
    NowherePush \
    AuroraStore \
    AuroraServices

# AuroraServices privileged-installer allow-list (DIA-20260731, "Option 2"): grant INSTALL_PACKAGES +
# DELETE_PACKAGES to com.aurora.services so Aurora installs Play apps SILENTLY (no per-app system dialog). The
# allow-list MUST live on /product -- the priv-app's own partition -- or PackageManager rejects it.
PRODUCT_COPY_FILES += \
    vendor/endospore/etc/permissions/privapp-permissions-com.aurora.services.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/permissions/privapp-permissions-com.aurora.services.xml

# !!! E.2b -- SEPOLICY DOMAIN (the central GrapheneOS port problem) !!!
# The init services above run as `seclabel u:r:su:s0` (core/vendor-common/etc/nowhere.rc). On the
# LineageOS FP3 that worked because LineageOS keeps a FUNCTIONAL `su` domain even in user builds (its
# root feature). GrapheneOS gates EVERY su privilege behind userdebug_or_eng() -- in our `lynx-cur-user`
# build the `su` type exists but has zero allow rules, so those four services would be fully confined
# and the roam flow dies. E.2b defines a proper privileged domain (endospore_priv) in
# editions/endospore/sepolicy/, ships an endospore override of nowhere.rc that uses the new seclabel,
# and wires the sepolicy dir into the board. This scaffold (E.2a) lands the build plumbing only; it is
# NOT yet buildable into a working roam until E.2b. See docs/endospore-spec.md (E.2) + the README.

# Pre-grant POST_NOTIFICATIONS to the chooser so its user-0 process can raise the "not backed up"
# notification in the foreground roamed user (DIA-20260619-12). Runtime perm -> privapp-permissions
# doesn't cover it; granted at every user's creation. Generic (no LineageOS dependency); kept.
PRODUCT_COPY_FILES += \
    vendor/endospore/default-permissions/nowhere-chooser-notifications.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/nowhere-chooser-notifications.xml \
    vendor/endospore/default-permissions/nowhere-chooser-telephony.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/nowhere-chooser-telephony.xml \
    vendor/endospore/default-permissions/nowhere-chooser-sms.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/nowhere-chooser-sms.xml \
    vendor/endospore/default-permissions/nowhere-chooser-calls.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/nowhere-chooser-calls.xml \
    vendor/endospore/default-permissions/nowhere-etar-calendar.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/nowhere-etar-calendar.xml

# OS version stamp: bake the Endospore version into /system so the running OS reports it (and OTAs are
# detectable v1 -> v2). Verified-boot-protected like the rest of /system.
PRODUCT_COPY_FILES += \
    vendor/endospore/etc/nowhere-ota-version:$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere-ota-version
# NWP-20261006-12: and its notes, when stage-vendor.sh found some for this version (the gate's "what's in it").
PRODUCT_COPY_FILES += \
    $(if $(wildcard vendor/endospore/etc/nowhere-ota-notes),vendor/endospore/etc/nowhere-ota-notes:$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere-ota-notes)

# Per-DEVICE OS payload ref (E.4): nowhere_otad publishes/pulls the A/B OTA under this store ref, and the
# agent derives its channel from it (os-<dev> -> ota/<dev>/version). A Pixel image is not interchangeable
# with the FP3's, nor one Pixel's with another's, so each device bakes its own.
#
# ⚠ SELECTED BY TARGET_PRODUCT FROM A PER-DEVICE SOURCE (os-ref-<dev>, staged for every device by
# stage-vendor), NOT from a single shared vendor/endospore/etc/os-ref. That shared path was written by
# whichever device staged last, so two CONCURRENT per-device builds silently baked another device's OTA
# channel into an otherwise correct-looking image. Selecting by device makes parallel builds safe, and
# fails loudly instead: an unstaged device has no os-ref-<dev> and the copy errors at build time.
#
# ⚠ TARGET_PRODUCT, *not* TARGET_DEVICE or PRODUCT_DEVICE -- both of those are EMPTY where this file is
# parsed (measured, not assumed: a $(warning) probe here prints TARGET_DEVICE=[] PRODUCT_DEVICE=[]
# TARGET_PRODUCT=[lynx]). Using an empty one silently resolves to `os-ref-` and the build dies with a
# missing-dependency chain rather than anything that names the real problem.
PRODUCT_COPY_FILES += \
    vendor/endospore/etc/os-ref-$(TARGET_PRODUCT):$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere/os-ref
# NWP-20261125-04 (h55 #2, docs/product-decisions.md 2026-11-03): the date GrapheneOS full support for this device
# ends, when staging found one (support-end-<dev>, staged for every device by stage-vendor). The gate and Profile read
# it offline. Absent = nothing baked = no line. ⚠ TARGET_PRODUCT, not TARGET_DEVICE: see the os-ref copy above.
PRODUCT_COPY_FILES += \
    $(if $(wildcard vendor/endospore/etc/support-end-$(TARGET_PRODUCT)),vendor/endospore/etc/support-end-$(TARGET_PRODUCT):$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere/support-end)

# NWP-20261104-08 (Q094 (c), docs/product-decisions.md): the commit this tree was staged from, written by
# stage-vendor.sh and read back out of the signed artifact by verify-release.sh (check 8). UNCONDITIONAL on purpose:
# a tree staged before this change has no such file and must be re-staged, so the build fails loudly here, as it does
# for an unstaged os-ref-<dev>, instead of shipping an image that cannot say where it came from.
PRODUCT_COPY_FILES += \
    vendor/endospore/etc/nowhere-source-commit:$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere/source-commit

# Default home page-2 apps (E.5d, DIA-20260710). The AOSP/GrapheneOS Launcher3 default-layout importer only
# imports the dock from default_workspace; it drops multi-screen desktop items. So nowhere_roamd.sh seed_home()
# injects these into a fresh roamed profile's launcher.db after first login, giving the same two-page home as
# the FP3. Endospore-only (the FP3's Trebuchet imports both pages); baked read-only in /system.
PRODUCT_COPY_FILES += \
    vendor/endospore/etc/default-home:$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere/default-home

# NWP-20261130-12 (Q012): the curated per-user settings allowlist that roamd's seal capture and the chooser's apply read.
PRODUCT_COPY_FILES += \
    vendor/endospore/etc/settings-roam.list:$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere/settings-roam.list

# App-store catalog (Phase 2, DIA-20260730): the signed JSON manifest of apps Nowhere OFFERS, served to the
# storefront via the GET-CATALOG daemon verb. Shared core seed (core/vendor-common/etc/catalog.json); the
# release-signed .sig is baked when present. Baked read-only in /system (rides verified boot).
PRODUCT_COPY_FILES += \
    vendor/endospore/etc/catalog.json:$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere/catalog.json
ifneq ($(wildcard vendor/endospore/etc/catalog.json.sig),)
PRODUCT_COPY_FILES += \
    vendor/endospore/etc/catalog.json.sig:$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere/catalog.json.sig
endif

# App-store full-catalog F-Droid SEARCH (Phase B, DIA-20260731): the SIGNED trimmed F-Droid index + a local icon
# pack, baked read-only in /system (verified boot). Generated by prebuilts/publish-fdroid-index.sh and staged into
# vendor/etc at build time (gitignored, ~12 MB, like the fetched default-app APKs), so copy them ONLY when present.
# index.json is verified against the SEPARATE indexPubKey (core/agent/index.go); icons served LOCALLY from
# icons.pack (zero browse leak).
ifneq ($(wildcard vendor/endospore/etc/index.json),)
PRODUCT_COPY_FILES += \
    vendor/endospore/etc/index.json:$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere/index.json \
    vendor/endospore/etc/index.json.sig:$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere/index.json.sig \
    vendor/endospore/etc/icons.pack:$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere/icons.pack \
    vendor/endospore/etc/icons.pack.sig:$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere/icons.pack.sig
endif

# Per-device default timezone + locale (DIA-20260616-58): a no-GApps / no-SIM device has no NITZ, so the
# framework's timezone detector falls back to the build default. Bake a sensible market default so a fresh
# /data comes up in a real zone instead of GMT; ro.nowhere.default.* are the chooser's fallback constants
# applied on login when a profile carries none. Generic; kept.
PRODUCT_PRODUCT_PROPERTIES += \
    persist.sys.timezone=America/New_York \
    ro.nowhere.default.timezone=America/New_York \
    ro.nowhere.default.locale=en-US

# Per-edition brand shown on the gate (the chooser reads ro.nowhere.brand; the shared core defaults to
# "nowhere"). Edition-level (Tier 2): Endospore = endospore; the FP3 sets diaspore in diaspore.mk.
PRODUCT_PRODUCT_PROPERTIES += \
    ro.nowhere.brand=endospore

# ---------------------------------------------------------------------------------------------------
# Curated default apps (DIA-20260622-01). Rule: use the GrapheneOS-native app where one exists -- so the
# browser is VANADIUM (hardened Chromium, already in the GrapheneOS image) and Fennec is DROPPED -- and
# pre-install from F-Droid only what GrapheneOS lacks. Camera/Gallery/Contacts/Clock/Calculator/Files/PDF
# are GrapheneOS-native too (not re-shipped). CALENDAR IS NOT: GrapheneOS ships the CalendarProvider but no
# calendar UI, so Etar is shipped -- without it the first-login ingest writes events nobody can see
# (NWP-20260827-22). The 10 below are the FP3 set minus Fennec, plus Thunderbird, baked into
# /product/app via the shared android_app_import modules (vendor/endospore/Android.bp = core/vendor-common);
# presigned, so F-Droid keeps its signature and can update them in place. APKs live in
# vendor/endospore/prebuilts (gitignored; fetched by prebuilts/fetch-default-apps.sh like the FP3).
# ⚠ The in-place update holds on Diaspore ONLY: GrapheneOS refuses every system-app update that does not come from
# its first-party app source, so on Endospore a bundled app moves only with the image (NWP-20260924-05).
PRODUCT_PACKAGES += \
    OrganicMaps \
    Conversations \
    BreezyWeather \
    Aegis \
    NewPipe \
    AntennaPod \
    Catima \
    Notally \
    Etar \
    Thunderbird

# Native JNI .so for the apps that ship them compressed (extractNativeLibs=true): a verbatim system app
# never unpacks them, so OrganicMaps would crash at launch. fetch-default-apps.sh
# extracts each arm64 .so into prebuilts/jni/<App> and generates this fragment -- run for Endospore with
# JNI_APPS="OrganicMaps" (no Fennec; Thunderbird's, NewPipe's and AntennaPod's libs are uncompressed, no
# extraction: NWP-20261029-26).
# Generated + .gitignored.
-include vendor/endospore/prebuilts/default-apps-jni.mk

# Build-time resource overlays (DIA-20260622): the Launcher3 default home layout (the 5x5 dock-only home
# for fresh roamed profiles -- a device-tier asset, editions/endospore/devices/<device>/vendor/overlay/.../
# default_workspace_5x5.xml, staged into vendor/endospore/overlay). PRODUCT_PACKAGE_OVERLAYS overlays res
# into the source-built com.android.launcher3 at build time (same mechanism as the FP3).
PRODUCT_PACKAGE_OVERLAYS += vendor/endospore/overlay

# NWP-20261004-01: framework (android) config for every Endospore device, as a NAMED runtime overlay -- a static
# framework-res overlay here collides with adevtool's own framework-res__<device>__auto_generated_rro_product module.
# Carries config_allowAlarmsOnStoppedUsers=false: AlarmManager never restarts a cold-locked user for its alarm; the
# gate rings it instead (docs/product-decisions.md, 2026-10-04). Source: editions/endospore/vendor/rro/.
PRODUCT_PACKAGES += NowhereFrameworkOverlay

# Endospore boot animation (DIA-20260622): a branded boot for the OS-boot phase. GrapheneOS ships its boot
# logo in the com.android.bootanimation APEX (search order: APEX, /product/media, /oem, /system) -- but on
# lynx that APEX is absent, so /product/media wins. CRITICAL: BootAnimation picks bootanimation-DARK.zip
# when ro.boot.theme==1 (this device boots dark); without it, it falls through every path to GrapheneOS's
# built-in fallback logo. So copy our ONE (already-dark) animation to BOTH filenames -> it wins in either
# theme. The zip is STORED (Android mmaps each frame); generated by core/vendor-common/make-bootanimation.ps1
# (-Wordmark endospore). Staged from editions/endospore/vendor/media by stage-vendor.
PRODUCT_COPY_FILES += \
    vendor/endospore/media/bootanimation.zip:$(TARGET_COPY_OUT_PRODUCT)/media/bootanimation.zip \
    vendor/endospore/media/bootanimation.zip:$(TARGET_COPY_OUT_PRODUCT)/media/bootanimation-dark.zip

# Endospore SHUTDOWN animation (the spore gathering inward + the wordmark fading on power-off). Simpler
# than the boot path: the shutdown search order is /product/media first with no APEX and no -dark variant,
# so this one file wins. STORED zip; generated by make-shutdownanimation.ps1 (-Wordmark endospore).
PRODUCT_COPY_FILES += \
    vendor/endospore/media/shutdownanimation.zip:$(TARGET_COPY_OUT_PRODUCT)/media/shutdownanimation.zip

# ---------------------------------------------------------------------------------------------------
# DEFERRED to a later Endospore slice (generic-capable, not needed to prove the roam):
#   * the offline geotz timezone provider (tier 3).
# IN PROGRESS (DIA-20260622): the remaining branding label (the fastbootd "GrapheneOS" recovery string).
# DONE: default apps, 5x5 dock-only home, gray chooser icon, per-edition gate brand, boot animation.

# OPT-IN turnkey self-provision (conditional on the files existing; .gitignored so a clean checkout
# builds an UN-ENROLLED OS and creds never enter git). Same mechanism as the FP3: a baked discovery
# config lets a freshly flashed device bootstrap its store from name+passphrase alone; baking the full
# store conf additionally makes Create work pre-login. SECURITY: baking real keys puts them in read-only
# /system (plaintext-at-rest) -- dev/turnkey only; production wants a scoped least-privilege token.
# NOTE: both files must be LF (CRLF -> trailing \r breaks the agent).
ifneq ($(wildcard vendor/endospore/etc/discovery.conf),)
PRODUCT_COPY_FILES += \
    vendor/endospore/etc/discovery.conf:$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere/discovery.conf
endif
ifneq ($(wildcard vendor/endospore/etc/nowhere.conf),)
PRODUCT_COPY_FILES += \
    vendor/endospore/etc/nowhere.conf:$(TARGET_COPY_OUT_SYSTEM)/etc/nowhere/nowhere.conf
endif

# #159 Slice 1: default always-on VPN app + the app_process helper roamd uses to establish always-on VPN for
# a roamed user (IVpnManager.setAlwaysOnVpnPackage -- the secure setting alone is not honored for a fresh user).
# NWP-20261010-15: the helpers are built from source (vendor/endospore/helpers/Android.bp) and installed to
# /system_ext/framework/<module>.jar, no longer a committed prebuilt; nowhere-syncroam carries account sync across
# a sign-out the same way.
PRODUCT_PACKAGES += WireGuard
PRODUCT_PACKAGES += nowhere-vpnao nowhere-syncroam
